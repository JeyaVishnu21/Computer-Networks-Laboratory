#include <stdio.h>
#include <string.h>

int main() {
    char text[50];
    char data[400]; // 50 chars * 8 bits = 400 bits maximum
    int datalen, r, codelen, i, j, k, pos;
    int codeword[500], received[500]; // Expanded array bounds for safety
    int choice, errorpos;

    // 1. Get text string input safely
    printf("Enter a text string: ");
    scanf("%49s", text); // Prevents buffer overflow

    // 2. Convert text string to binary bits string
    j = 0;
    for (i = 0; text[i] != '\0'; i++) {
        char ch = text[i];
        // Extract 8 bits from MSB to LSB
        for (k = 7; k >= 0; k--) {
            int bit = (ch >> k) & 1;
            data[j] = bit + '0'; // Convert integer bit to '0' or '1'
            j = j + 1;
        }
    }
    data[j] = '\0'; // Null-terminate the constructed binary string

    datalen = strlen(data);

    // 3. Calculate number of parity bits needed
    r = 0;
    while ((1 << r) < datalen + r + 1) {
        r = r + 1;
    }

    codelen = datalen + r;

    // 4. Place data bits leaving spaces for parity bits (1-indexed)
    j = 0;
    for (i = 1; i <= codelen; i++) {
        if ((i & (i - 1)) == 0) {
            codeword[i] = -1;
        } else {
            codeword[i] = data[j] - '0';
            j = j + 1;
        }
    }

    // 5. Calculate even parity values
    for (i = 0; i < r; i++) {
        pos = 1 << i;
        int count = 0;
        for (j = pos; j <= codelen; j = j + 1) {
            if (((j / pos) % 2) == 1) {
                if (codeword[j] == 1) {
                    count = count + 1;
                }
            }
        }
        if (count % 2 == 0) {
            codeword[pos] = 0;
        } else {
            codeword[pos] = 1;
        }
    }

    printf("\n--- Sender Side ---\n");
    printf("Original Text: %s\n", text);
    printf("Converted Data bits (%d bits): %s\n", datalen, data);
    printf("Number of parity bits: %d\n", r);
    printf("Transmitted codeword: ");
    for (i = 1; i <= codelen; i++) {
        printf("%d", codeword[i]);
    }
    printf("\n");

    // Copy to receiver side
    for (i = 1; i <= codelen; i++) {
        received[i] = codeword[i];
    }

    // 6. Optional error injection
    printf("\nDo you want to introduce an error during transmission? (1 for yes, 0 for no): ");
    scanf("%d", &choice);

    if (choice == 1) {
        printf("Enter bit position to flip (1 to %d): ", codelen);
        scanf("%d", &errorpos);

        // Input validation boundary check
        if (errorpos >= 1 && errorpos <= codelen) {
            if (received[errorpos] == 0) {
                received[errorpos] = 1;
            } else {
                received[errorpos] = 0;
            }
        } else {
            printf("Invalid position! No error introduced.\n");
        }
    }

    printf("\n--- Receiver Side ---\n");
    printf("Received codeword: ");
    for (i = 1; i <= codelen; i++) {
        printf("%d", received[i]);
    }
    printf("\n");

    // 7. Error detection via Syndrome calculation
    int syndrome = 0;
    for (i = 0; i < r; i++) {
        pos = 1 << i;
        int count = 0;
        for (j = pos; j <= codelen; j = j + 1) {
            if (((j / pos) % 2) == 1) {
                if (received[j] == 1) {
                    count = count + 1;
                }
            }
        }
        if (count % 2 != 0) {
            syndrome = syndrome + pos;
        }
    }

    printf("Syndrome (error position): %d\n", syndrome);

    if (syndrome == 0) {
        printf("Result: No error detected\n");
    } else {
        printf("Result: Error detected at position %d\n", syndrome);
        if (received[syndrome] == 0) {
            received[syndrome] = 1;
        } else {
            received[syndrome] = 0;
        }
        printf("Corrected codeword: ");
        for (i = 1; i <= codelen; i++) {
            printf("%d", received[i]);
        }
        printf("\n");
    }

    // 8. Extract binary data back
    j = 0;
    char correcteddata[400];
    for (i = 1; i <= codelen; i++) {
        if ((i & (i - 1)) != 0) {
            correcteddata[j] = received[i] + '0';
            j = j + 1;
        }
    }
    correcteddata[j] = '\0';

    printf("Extracted data bits: %s\n", correcteddata);

    // 9. Convert binary data back to a Text String
    char correctedtext[50];
    int text_idx = 0;
    for (i = 0; i < datalen; i += 8) {
        char ch = 0;
        for (k = 0; k < 8; k++) {
            ch = (ch << 1) | (correcteddata[i + k] - '0');
        }
        correctedtext[text_idx++] = ch;
    }
    correctedtext[text_idx] = '\0';

    printf("Decoded Text output: %s\n", correctedtext);

    return 0;
}
